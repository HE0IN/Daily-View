# 호스팅
APP_PORT=8501
APP_HOST=0.0.0.0

# 데이터 경로 (절대경로 권장)
DATA_DIR=C:\Users\duddl\Desktop\Project\Daily View\data

# 업로드 제한
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_ITEM=20

# 자동 아카이브
AUTO_ARCHIVE_DAYS=14

# 자동 새로고침 (초)
AUTO_REFRESH_SEC=30

# AI 질문 (사내 LLM, OpenAI 호환) — C-DEP 과 같은 값을 쓰면 됩니다.
# 실제 값은 .env 에만 넣으세요 (.env 는 git 에 올라가지 않음).
LLM_API_URL=http://사내주소/v1/chat/completions
LLM_API_KEY=발급받은-키
LLM_MODEL=google/gemma-4-31b-it
LLM_TIMEOUT=120
